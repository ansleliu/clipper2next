find_package(Python3 COMPONENTS Interpreter REQUIRED)
set(clipper2next_gate_output_dir "${PROJECT_BINARY_DIR}/gates")
file(MAKE_DIRECTORY "${clipper2next_gate_output_dir}")

set(CLIPPER2NEXT_LEGACY_CORPUS_SOURCE_ROOT "$ENV{CLIPPER2NEXT_GEOMETRY_CORPUS_SOURCE_ROOT}"
  CACHE PATH "Read-only geometry parent containing the five original legacy text inputs")
set(CLIPPER2NEXT_CORRECTION_FULL_RECEIPT "" CACHE FILEPATH "Explicit frozen full-corpus receipt for qualification")
set(CLIPPER2NEXT_CORRECTION_FULL_RECEIPT_SHA256 "" CACHE STRING "Pre-execution SHA256 of the full-corpus receipt")
set(corpus_selection_args --configure --output-dir "${clipper2next_gate_output_dir}/vendored-corpus")
if(CLIPPER2NEXT_CORRECTION_FULL_RECEIPT)
  file(READ "${CLIPPER2NEXT_CORRECTION_FULL_RECEIPT}" corpus_full_json)
  string(JSON corpus_legacy_source GET "${corpus_full_json}" source_root)
  list(APPEND corpus_selection_args
    --full-receipt "${CLIPPER2NEXT_CORRECTION_FULL_RECEIPT}"
    --full-receipt-sha256 "${CLIPPER2NEXT_CORRECTION_FULL_RECEIPT_SHA256}")
else()
  set(corpus_legacy_source "${CLIPPER2NEXT_LEGACY_CORPUS_SOURCE_ROOT}")
endif()
if(NOT corpus_legacy_source)
  message(FATAL_ERROR "Oracle configuration needs CLIPPER2NEXT_LEGACY_CORPUS_SOURCE_ROOT; original text inputs are never fabricated or silently skipped")
endif()
list(APPEND corpus_selection_args --legacy-source "${corpus_legacy_source}")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/release/prepare_correction_corpus.py" ${corpus_selection_args}
  RESULT_VARIABLE corpus_selection_result OUTPUT_VARIABLE corpus_selection_path
  ERROR_VARIABLE corpus_selection_error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT corpus_selection_result EQUAL 0)
  message(FATAL_ERROR "Corpus configuration failed: ${corpus_selection_error}")
endif()
file(READ "${corpus_selection_path}" corpus_selection_json)
file(SHA256 "${corpus_selection_path}" corpus_selection_sha256)
string(JSON corpus_scope GET "${corpus_selection_json}" scope)
string(JSON corpus_root GET "${corpus_selection_json}" selected derived_root)
string(JSON corpus_source GET "${corpus_selection_json}" selected source_root)
string(JSON corpus_manifest_sha256 GET "${corpus_selection_json}" selected sha256)
file(TO_CMAKE_PATH "${corpus_root}" corpus_root)
file(TO_CMAKE_PATH "${corpus_source}" corpus_source)
set(CLIPPER2NEXT_SELECTED_CORPUS_SCOPE "${corpus_scope}" CACHE INTERNAL "Configured corpus authority scope" FORCE)
set(CLIPPER2NEXT_SELECTED_CORPUS_ROOT "${corpus_root}" CACHE INTERNAL "Configured frozen consumer input root" FORCE)
set(CLIPPER2NEXT_SELECTED_CORPUS_MANIFEST_SHA256 "${corpus_manifest_sha256}" CACHE INTERNAL "Configured immutable manifest hash" FORCE)
set(CLIPPER2NEXT_SELECTED_CORPUS_SELECTION "${corpus_selection_path}" CACHE INTERNAL "Configured source selection" FORCE)
set(CLIPPER2NEXT_SELECTED_CORPUS_SELECTION_SHA256 "${corpus_selection_sha256}" CACHE INTERNAL "Configured source selection hash" FORCE)
set(CLIPPER2NEXT_CORPUS_PREFLIGHT_ARGS --corpus-root "${corpus_root}" --original-root "${corpus_source}" --frozen-corpus-sha256 "${corpus_manifest_sha256}" CACHE INTERNAL "Explicit fixed corpus arguments" FORCE)
if(corpus_scope STREQUAL "full-external")
  set(CLIPPER2NEXT_TRIANGULATION_PREFLIGHT "${PROJECT_SOURCE_DIR}/tools/release/run_triangulation_contract_preflight.py" CACHE INTERNAL "Configured authority entry" FORCE)
elseif(corpus_scope STREQUAL "vendored-profile")
  set(CLIPPER2NEXT_TRIANGULATION_PREFLIGHT "${PROJECT_SOURCE_DIR}/tools/release/run_vendored_triangulation_preflight.py" CACHE INTERNAL "Configured authority entry" FORCE)
else()
  message(FATAL_ERROR "Unknown configured corpus scope")
endif()
